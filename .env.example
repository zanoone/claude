#--------------------------------------------------------------------
# SmartKim.shop - 환경 설정 예시
# 이 파일을 복사하여 .env 파일을 만들고 실제 값으로 변경하세요
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE - MySQL (로컬)
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = smartkim_db
database.default.username = root
database.default.password = your_password_here
database.default.DBDriver = MySQLi
database.default.port = 3306

#--------------------------------------------------------------------
# DATABASE - Railway (무료 클라우드 MySQL)
# https://railway.app 에서 MySQL 생성 후 정보 입력
#--------------------------------------------------------------------

# database.default.hostname = containers-us-west-xxx.railway.app
# database.default.database = railway
# database.default.username = root
# database.default.password = your-railway-password
# database.default.DBDriver = MySQLi
# database.default.port = 6543

#--------------------------------------------------------------------
# DATABASE - PlanetScale (Serverless MySQL)
# https://planetscale.com 에서 DB 생성 후 정보 입력
#--------------------------------------------------------------------

# database.default.hostname = aws.connect.psdb.cloud
# database.default.database = smartkim-db
# database.default.username = your-username
# database.default.password = your-password
# database.default.DBDriver = MySQLi
# database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
# 보안을 위해 반드시 새로운 키를 생성하세요!
# php spark key:generate 명령어 사용
#--------------------------------------------------------------------

encryption.key = hex2bin:7f3c8c3f9b7a8e9f8c9d8e9f7a8b9c8d7e8f9a8b9c8d8e9f7a8b9c8d7e8f9a8b

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

logger.threshold = 4
